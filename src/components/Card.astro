---
interface Props {
    points: number;
    question: string;
}

const { points, question } = Astro.props;
---

<button type="button" class="game-card group grid min-h-24 cursor-pointer rounded-lg bg-neutral-900 transition-colors duration-200 ease-out hover:bg-neutral-800 active:scale-[0.98] sm:min-h-32"
    aria-pressed="false">
    <span class="col-start-1 row-start-1 flex items-center justify-center px-3 text-3xl font-semibold tabular-nums text-gold transition-opacity duration-200 ease-out group-aria-pressed:opacity-0">
        {points}
    </span>
    <span class="col-start-1 row-start-1 flex items-center justify-center rounded-lg bg-gold p-4 text-center text-sm font-medium leading-snug text-neutral-950 opacity-0 transition-opacity duration-200 ease-out group-aria-pressed:opacity-100 sm:text-base">
        {question}
    </span>
</button>

<script>
    document.querySelectorAll('.game-card').forEach((card) => {
        card.addEventListener('click', () => {
            const pressed = card.getAttribute('aria-pressed') === 'true';
            card.setAttribute('aria-pressed', String(!pressed));
        });
    });
</script>
