---
import Card from './Card.astro';
import questionsData from './questions.json';

const topics = Object.keys(questionsData) as Array<keyof typeof questionsData>;
---

<div class="flex flex-col min-h-screen p-6 gap-8">
    {topics.map(topic => (
    <div class="group flex flex-col gap-4">
        <h2 class="text-xl font-bold text-center p-3 rounded-lg 
                    group-hover:text-yellow-200 transition duration-300">
            {topic}
        </h2>
        <div class="flex flex-wrap gap-4 justify-center">
            {Object.entries(questionsData[topic]).map(([points, question]) => (
            <Card points={Number(points)} question={question} />
            ))}
        </div>
    </div>
    ))}
</div>

