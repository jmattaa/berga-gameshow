---
import Card from './Card.astro';
import questionsData from './questions.json';

const topics = Object.keys(questionsData) as Array<keyof typeof questionsData>;
---

<div class="flex flex-col gap-8">
    {topics.map(topic => (
    <section class="flex flex-col gap-3">
        <h2 class="text-sm font-medium uppercase tracking-[0.08em] text-neutral-400">
            {topic}
        </h2>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
            {Object.entries(questionsData[topic]).map(([points, question]) => (
            <Card points={Number(points)} question={question} />
            ))}
        </div>
    </section>
    ))}
</div>
